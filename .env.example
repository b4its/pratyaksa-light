# ============================================================
# Pratyaksa (FastAPI + Svelte) — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=pratyaksa
POSTGRES_PASSWORD=pratyaksa_secret
POSTGRES_DB=pratyaksa_db
POSTGRES_PORT=5468

# --- MongoDB ---
MONGO_USER=pratyaksa
MONGO_PASSWORD=pratyaksa_secret
MONGO_DB=pratyaksa
MONGO_PORT=27053

# --- Backend (FastAPI) ---
# BACKEND_PORT = port host yang di-expose; SERVER_PORT = port internal container
BACKEND_PORT=8116
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
JWT_SECRET=super_secret_pratyaksa_key_change_in_production
JWT_EXPIRY_HOURS=24
# Comma-separated allowed CORS origins ("*" allows all)
CORS_ORIGINS=*

# --- Frontend (SvelteKit) ---
FRONTEND_PORT=3036
# URL API dari sudut pandang browser (lewat Nginx)
# Production: /api/v1  (path relatif, Nginx forward ke backend)
# Development: http://localhost:8116/api/v1
PUBLIC_API_BASE=/api/v1

# --- PRATYAKSA (Simulasi) ---
# Pratyaksa berjalan sepenuhnya dalam mode SIMULASI: data dihasilkan oleh
# engine Python internal. Tidak ada koneksi ke ML API / ML PostgreSQL eksternal.

# --- Telegram bot ---
TELEGRAM_GRPC_TARGET=telegram-bot:50051
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# URL backend dari sudut pandang container bot
BOT_BACKEND_URL=http://backend:8080
# Base URL tombol "Buat Work Order" di alert (dari sudut pandang penerima Telegram)
WO_LINK_BASE=http://10.40.2.117

# --- Nginx (pintu utama aplikasi) ---
APP_PORT=116

# --- Optional Tools ---
MONGO_EXPRESS_PORT=8117
PGADMIN_PORT=5086
PGADMIN_EMAIL=admin@pratyaksa.id
PGADMIN_PASSWORD=admin123
