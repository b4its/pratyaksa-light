# ============================================================
# Pratyaksa (FastAPI + Svelte) — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=pratyaksa
POSTGRES_PASSWORD=pratyaksa_secret
POSTGRES_DB=pratyaksa_db
POSTGRES_PORT=5432

# --- MongoDB ---
MONGO_USER=pratyaksa
MONGO_PASSWORD=pratyaksa_secret
MONGO_DB=pratyaksa
MONGO_PORT=27017

# --- Backend (FastAPI) ---
BACKEND_PORT=8080
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
JWT_SECRET=super_secret_pratyaksa_key_change_in_production
JWT_EXPIRY_HOURS=24
MONGO_BATCH_SIZE=100
# Comma-separated allowed CORS origins ("*" allows all)
CORS_ORIGINS=*

# --- Frontend (SvelteKit) ---
FRONTEND_PORT=3000
# URL API dari sudut pandang browser (lewat Nginx)
# Production: /api/v1  (path relatif, Nginx forward ke backend)
# Development: http://localhost:8080/api/v1
PUBLIC_API_BASE=/api/v1

# --- PRATYAKSA ML API — target endpoint ML eksternal ---
ML_TARGET_URL=http://192.168.101.3:6000
LIVE_API_KEY=dev-key-pratyaksa
PRATYAKSA_POLL_INTERVAL=5

# --- ml-pratyaksa PostgreSQL (untuk sync data ML ke MongoDB) ---
ML_POSTGRES_URL=postgresql://pratyaksa:pratyaksa_secret@192.168.101.3:5432/pratyaksa
ML_SYNC_INTERVAL=60

# --- Telegram bot (gRPC) ---
TELEGRAM_GRPC_TARGET=telegram-bot:50051

# --- Nginx (pintu utama aplikasi) ---
APP_PORT=80

# --- Optional Tools ---
MONGO_EXPRESS_PORT=8081
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@pratyaksa.id
PGADMIN_PASSWORD=admin123
