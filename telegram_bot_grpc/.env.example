# ============================================================
# PRATYAKSA Telegram Bot — Environment Variables
# Copy this file to .env for standalone (non-Docker) runs.
# ============================================================

# --- gRPC server (dipanggil oleh backend FastAPI) ---
GRPC_HOST=0.0.0.0
GRPC_PORT=50051

# --- Telegram ---
# Token bot dari @BotFather (wajib untuk long-polling)
TELEGRAM_BOT_TOKEN=
# Chat ID default (opsional) — otomatis ditambahkan sebagai subscriber
TELEGRAM_CHAT_ID=

# --- Backend FastAPI (sumber data laporan) ---
BACKEND_URL=http://localhost:8114

# --- Link Work Order yang dikirim di alert ---
WO_LINK_BASE=http://localhost:114

# --- Penyimpanan daftar subscriber ---
SUBSCRIBERS_FILE=./data/subscribers.json

# --- Log level (opsional) ---
LOG_LEVEL=INFO
